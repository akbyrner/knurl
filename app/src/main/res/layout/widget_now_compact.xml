<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_bg" android:padding="10dp">
    <ImageView android:id="@+id/art" android:layout_width="54dp" android:layout_height="54dp" android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="4dp" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
        <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#FFB0B1B6" android:textSize="11sp" />
    </LinearLayout>
    <ImageButton android:id="@+id/play" android:layout_width="44dp" android:layout_height="44dp" android:background="@null" android:scaleType="fitCenter" android:contentDescription="Play or pause" />
</LinearLayout>
