<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PINNED" android:textColor="#FF8E9097" android:textSize="10sp" android:fontFamily="monospace" android:letterSpacing="0.16" />
        <ImageView android:id="@+id/mark" android:layout_width="12dp" android:layout_height="12dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="horizontal">
        <ImageButton android:id="@+id/p0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:scaleType="fitXY" android:contentDescription="Liked Songs" />
        <ImageView android:layout_width="8dp" android:layout_height="1dp" />
        <ImageButton android:id="@+id/p1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:scaleType="fitXY" android:contentDescription="Last played album" />
    </LinearLayout>
    <ImageView android:layout_width="1dp" android:layout_height="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <ImageButton android:id="@+id/p2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:scaleType="fitXY" android:contentDescription="Recently Added" />
        <ImageView android:layout_width="8dp" android:layout_height="1dp" />
        <ImageButton android:id="@+id/p3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:scaleType="fitXY" android:contentDescription="On This Phone" />
    </LinearLayout>
</LinearLayout>
