<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <ImageView android:id="@+id/art" android:layout_width="120dp" android:layout_height="120dp" android:scaleType="centerCrop" />
        <LinearLayout android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="NOW PLAYING" android:textColor="#FF8E9097" android:textSize="10sp" android:fontFamily="monospace" android:letterSpacing="0.16" />
                <ImageView android:id="@+id/mark" android:layout_width="14dp" android:layout_height="14dp" />
            </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:singleLine="true" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
            <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#FFB0B1B6" android:textSize="13sp" />
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:progressDrawable="@drawable/widget_progress" android:max="1000" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal">
                <TextView android:id="@+id/pos" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FF9A9AA0" android:textSize="10sp" android:fontFamily="monospace" />
                <TextView android:id="@+id/left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF9A9AA0" android:textSize="10sp" android:fontFamily="monospace" />
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/prev" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/widget_tb_bg" android:src="@drawable/ic_widget_prev" android:padding="11dp" android:contentDescription="Previous" />
            <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/play" android:layout_width="46dp" android:layout_height="46dp" android:background="@null" android:scaleType="fitCenter" android:contentDescription="Play or pause" />
            <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/next" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/widget_tb_bg" android:src="@drawable/ic_widget_next" android:padding="11dp" android:contentDescription="Next" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:background="#14FFFFFF" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UP NEXT" android:textColor="#FF8E9097" android:textSize="10sp" android:fontFamily="monospace" android:letterSpacing="0.16" />
    <LinearLayout android:id="@+id/q0" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/q0i" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="centerCrop" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/q0t" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#FFECEBE6" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
            <TextView android:id="@+id/q0a" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#FF9A9AA0" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/q1" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/q1i" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="centerCrop" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/q1t" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#FFECEBE6" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
            <TextView android:id="@+id/q1a" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#FF9A9AA0" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/q2" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/q2i" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="centerCrop" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/q2t" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#FFECEBE6" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
            <TextView android:id="@+id/q2a" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#FF9A9AA0" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
